<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ADVRModManager</RootNamespace>
    <ApplicationId>com.blckout.adv_mod_manager</ApplicationId>
    <ApplicationTitle>ADVR Mod Manager</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <!-- This APK is installed outside of an IDE; include managed assemblies instead of relying on Fast Deployment. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OnDeviceADB/OnDeviceADB.csproj" />
  </ItemGroup>
</Project>
